{
    "items": [
        {
            "name": "Alpine Linux PW6 (no kterm!)",
            "if": "\"kterm\" -ext!",
            "items": [
                {
                    "name": "Please install kterm extension (required)",
                    "action": "/bin/false"
                }
            ]
        },
        {
            "name": "Alpine Linux PW6",
            "if": "\"kterm\" -ext",
            "items": [
                {
                    "name": "Deploy newest release (clean install)",
                    "action": "sh bin/kterm_run.sh get.sh",
                    "exitmenu": false
                },
                {
                    "name": "Drop into Alpine Linux shell",
                    "action": "sh bin/kterm_run.sh start.sh",
                    "exitmenu": false
                },
                {
                    "name": "Start XFCE GUI session",
                    "action": "sh bin/kterm_run.sh xfce.sh",
                    "exitmenu": false
                },
                {
                    "name": "Start LXQT GUI session",
                    "action": "sh bin/kterm_run.sh lxqt.sh",
                    "exitmenu": false
                },
                {
                    "name": "Start MATE GUI session",
                    "action": "sh bin/kterm_run.sh mate.sh",
                    "exitmenu": false
                },
                {
                    "name": "GUI Installer",
                    "action": "sh bin/kterm_run.sh gui_installer.sh",
                    "exitmenu": false
                },
                {
                    "name": "Stop Alpine",
                    "action": "sh bin/kterm_run.sh stop.sh",
                    "exitmenu": false
                },
                {
                    "name": "Delete Alpine Linux Root",
                    "action": "sh bin/kterm_run.sh delete.sh",
                    "exitmenu": false
                },
                {
                    "name": "Delete Alpine HOME partition (User data and settings)",
                    "action": "sh bin/kterm_run.sh deletehome.sh",
                    "exitmenu": false
                },
                {
                    "name": "Update this KUAL Extension",
                    "action": "sh bin/kterm_run.sh update.sh",
                    "exitmenu": false
                }

            ]
        }
    ]
}